{
  "schema": "vasecreator/presets",
  "version": 1,
  "presets": [
    {
      "schema": "vasecreator/design",
      "version": 3,
      "units": "mm",
      "meta": {
        "id": "preset:classic-vase@1",
        "name": "Classic vase",
        "description": "A rounded body with a slim neck; flutes on the belly fade into a smooth neck."
      },
      "form": {
        "height": 170,
        "profile": {
          "interp": "catmullRomCentripetal",
          "tension": 0.5,
          "knots": [
            { "z": 0, "r": 42 },
            { "z": 55, "r": 62 },
            { "z": 128, "r": 31 },
            { "z": 170, "r": 39 }
          ]
        },
        "plan": { "footprint": "circle", "depthRatio": 1, "cornerRounding": 0 },
        "twist": { "degrees": 0 },
        "detail": {
          "fromMm": 10,
          "toMm": 150,
          "a": { "pattern": "lib:flutes@1", "depthMm": 2, "repeats": 12, "tileHeightMm": 20 },
          "b": { "pattern": "plain", "depthMm": 0, "repeats": 1, "tileHeightMm": 20 },
          "blend": { "shape": "fadesUp", "amount": 1 }
        }
      },
      "layers": {
        "beadWidthMm": 8,
        "layerHeightMm": 5,
        "seam": { "rampLengthMm": 15, "position": "hidden", "angleDeg": 0 }
      },
      "rules": { "overhangLimitDeg": 45, "supportRatio": 0.7, "curveRatio": 0.5, "layersPerBump": 2 },
      "base": { "layers": 2, "pattern": "spiral", "spacingRatio": 0.9, "outline": true, "hole": { "diameter": 0 } },
      "finish": { "walls": 1, "wallSpacingMm": 7.2, "innerWall": "smooth" }
    },
    {
      "schema": "vasecreator/design",
      "version": 3,
      "units": "mm",
      "meta": {
        "id": "preset:twisted-column@1",
        "name": "Twisted column",
        "description": "A gently swelling column with pleats that wind a sixth of a turn."
      },
      "form": {
        "height": 150,
        "profile": {
          "interp": "catmullRomCentripetal",
          "tension": 0.5,
          "knots": [
            { "z": 0, "r": 40 },
            { "z": 75, "r": 45 },
            { "z": 150, "r": 40 }
          ]
        },
        "plan": { "footprint": "rectangle", "depthRatio": 1, "cornerRounding": 0.3 },
        "twist": { "degrees": 60 },
        "detail": {
          "fromMm": 5,
          "toMm": 145,
          "a": { "pattern": "lib:pleats@1", "depthMm": 2, "repeats": 8, "tileHeightMm": 20 },
          "b": null,
          "blend": { "shape": "fadesUp", "amount": 1 }
        }
      },
      "layers": {
        "beadWidthMm": 8,
        "layerHeightMm": 5,
        "seam": { "rampLengthMm": 15, "position": "followTwist", "angleDeg": 0 }
      },
      "rules": { "overhangLimitDeg": 45, "supportRatio": 0.7, "curveRatio": 0.5, "layersPerBump": 2 },
      "base": { "layers": 2, "pattern": "spiral", "spacingRatio": 0.9, "outline": true, "hole": { "diameter": 0 } },
      "finish": { "walls": 1, "wallSpacingMm": 7.2, "innerWall": "smooth" }
    },
    {
      "schema": "vasecreator/design",
      "version": 3,
      "units": "mm",
      "meta": {
        "id": "preset:square-planter@1",
        "name": "Square planter",
        "description": "A flaring square planter with a basket weave and a drainage hole."
      },
      "form": {
        "height": 110,
        "profile": {
          "interp": "linear",
          "tension": 0.5,
          "knots": [
            { "z": 0, "r": 52, "corner": 0 },
            { "z": 110, "r": 62, "corner": 0 }
          ]
        },
        "plan": { "footprint": "rectangle", "depthRatio": 1, "cornerRounding": 0.3 },
        "twist": { "degrees": 0 },
        "detail": {
          "fromMm": 10,
          "toMm": 100,
          "a": { "pattern": "lib:basket@1", "depthMm": 2, "repeats": 4, "tileHeightMm": 40 },
          "b": null,
          "blend": { "shape": "fadesUp", "amount": 1 }
        }
      },
      "layers": {
        "beadWidthMm": 8,
        "layerHeightMm": 5,
        "seam": { "rampLengthMm": 15, "position": "hidden", "angleDeg": 0 }
      },
      "rules": { "overhangLimitDeg": 45, "supportRatio": 0.7, "curveRatio": 0.5, "layersPerBump": 2 },
      "base": { "layers": 2, "pattern": "spiral", "spacingRatio": 0.9, "outline": true, "hole": { "diameter": 20 } },
      "finish": { "walls": 1, "wallSpacingMm": 7.2, "innerWall": "smooth" }
    }
  ]
}
